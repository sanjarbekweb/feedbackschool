# =============================================================================
# School Psychology Support System - Backend Environment Configuration
# =============================================================================

# Server Environment
NODE_ENV=production
PORT=3001

# Database (PostgreSQL)
# Railway provides DATABASE_URL automatically when PostgreSQL plugin is added
DATABASE_URL="postgresql://postgres:password@localhost:5432/psychology_support?schema=public"

# Authentication & Security
# Generate a cryptographically random secret string: openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters"

# Cross-Origin Resource Sharing (CORS)
# Set to your Vercel frontend production URL, e.g. https://feedbackschool.vercel.app
CORS_ORIGIN="http://localhost:3000"

# Telegram Bot Configurations
# Obtain bot tokens from @BotFather on Telegram
STUDENT_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_student"
STAFF_BOT_TOKEN="987654321:ZYXwvUtSRqPoNmlKjIHGfedCBA_staff"

# Staff Group Chat ID
# The Telegram group ID where authorized staff receive privacy-safe new case alerts
# (e.g. -1001234567890). Notification contains: Case ID, category, status, and timestamp only.
STAFF_GROUP_ID="-1001234567890"

# Telegram Delivery Mode: 'polling' (development) or 'webhook' (production on Railway)
TELEGRAM_MODE="polling"

# Webhook configuration (Required when TELEGRAM_MODE=webhook)
# Backend public domain on Railway, e.g. https://feedbackschool-production.up.railway.app
TELEGRAM_WEBHOOK_URL="https://your-railway-app.up.railway.app"

# Optional Telegram webhook secret token to prevent spoofing
# Set an arbitrary alphanumeric string (1-256 chars, A-Z, a-z, 0-9, _, -)
TELEGRAM_WEBHOOK_SECRET="a_strong_random_secret_for_telegram_webhook"
