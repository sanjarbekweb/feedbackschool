# Environment Configuration for Backend
# Copy to .env for local development

NODE_ENV=development
PORT=3001

# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psychology_support?schema=public"

# Staff Authentication (JWT)
JWT_SECRET="replace_with_a_secure_random_secret_in_production"
JWT_EXPIRES_IN="24h"

# Telegram Bot Configurations
STUDENT_BOT_TOKEN="your_student_bot_token"
STAFF_BOT_TOKEN="your_staff_bot_token"
STAFF_TELEGRAM_GROUP_ID="-1001234567890"

# CORS
CORS_ORIGIN="http://localhost:3000"
