    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@psychology/types": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "typescript": "^5.8.2"
  }
}
