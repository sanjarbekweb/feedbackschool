{
  "name": "@psychology/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS Backend for School Psychology Support System",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
