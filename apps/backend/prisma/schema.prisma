datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

enum ConversationStatus {
  UNANSWERED
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum SenderType {
  STUDENT
  STAFF
  SYSTEM
}

enum ConversationCategory {
  GENERAL
  ACADEMIC
  PERSONAL
  SOCIAL
  URGENT
}

model User {
  id                String         @id @default(uuid())
  telegramId        String?        @unique
  email              String?        @unique
  passwordHash       String?
  role              UserRole       @default(STUDENT)
  isActive           Boolean        @default(true)
  credentialVersion Int            @default(1)
  studentIdentifier String?        // Anonymized student code e.g. "S-8492"
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  conversations     Conversation[]
  messages          Message[]
  auditLogs         AuditLog[]

  @@index([telegramId])
  @@index([role])
  @@map("users")
}

model Conversation {
  id            String               @id @default(uuid())
  caseId        String               @unique // Non-sensitive ID e.g. "#A81F42"
  studentId     String
  status        ConversationStatus   @default(UNANSWERED)
  category      ConversationCategory @default(GENERAL)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  lastMessageAt DateTime             @default(now())

  student       User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([status])
  @@index([studentId])
  @@index([lastMessageAt])
  @@index([category])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  senderType     SenderType
  content        String       // Message body - text only
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String   // e.g. "CONVERSATION_ACCESSED", "RESPONSE_SENT", "STATUS_UPDATED"
  targetType String   // e.g. "CONVERSATION"
  targetId   String   // Case ID or Conversation UUID
  metadata   Json?    // Contextual info (timestamps, field names) - NEVER sensitive message content
  createdAt  DateTime @default(now())

  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([targetId])
  @@map("audit_logs")
}
