# =============================================================================
# School Psychology Support System - Monorepo Root Environment Configuration
# =============================================================================

# Backend Configuration
PORT=3001
NODE_ENV=production
# Supabase Transaction Pooler (port 6543 with pgbouncer for application queries)
DATABASE_URL="postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true&connection_limit=10&connect_timeout=20"
# Supabase Direct/Session connection (port 5432 for prisma migrations)
DIRECT_URL="postgresql://postgres:password@aws-0-region.pooler.supabase.com:5432/postgres?schema=public&connect_timeout=20"
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters"
CORS_ORIGIN="http://localhost:3000"

# Telegram Bot Configurations
STUDENT_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_student"
STAFF_BOT_TOKEN="987654321:ZYXwvUtSRqPoNmlKjIHGfedCBA_staff"
STAFF_GROUP_ID="-1001234567890"
# Optional comma-separated Telegram IDs explicitly approved as administrators.
# There is no built-in fallback ID.
ADMIN_TELEGRAM_IDS=""
ADMIN_TELEGRAM_IDS="8264201735"

# Telegram Webhook (Railway Production)
TELEGRAM_MODE="polling"
TELEGRAM_WEBHOOK_URL="https://your-railway-app.up.railway.app"
TELEGRAM_WEBHOOK_SECRET="a_strong_random_secret_for_telegram_webhook"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:3001"
